doc-gen.config.yml
# Dependencies
node_modules/

# Build output
dist/

# Runtime output — never commit generated docs or unpacked solutions
output/
unpacked/

# Logs
dev.log
*.log

# TypeScript cache
*.tsbuildinfo

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Environment / secrets — for when we add ADO tokens later
.env
.env.*

# Solution ZIPs — build artifacts, not source
*.zip

# notes
*.txt

# ...but never a test fixture. Several fixtures are deliberately non-XML files
# whose whole job is to prove a parser skips them. Ignored, they vanish on a
# fresh clone and those tests pass vacuously in CI — green, and asserting nothing.
# Fixtures are synthetic by rule (tests/fixtures/README.md), so nothing here can
# be client data.
!tests/fixtures/**

#yml config file, required for client project, but should not be committed to source control as it may contain environment-specific settings
*doc-gen.config.yml

# AI enrichment cache — local/per-client artifact (contains real component names
# and AI-generated summaries from the client's solution). Regenerates automatically.
# Note: the architecture decision to "commit the cache for PR review" applies to a
# *client project repo* using powerautodocs, not to this tool's own repo.
.powerautodocs-ai-cache.json

# Rendered Mermaid diagram cache — same reasoning as the AI cache above.
.powerautodocs-diagram-cache/

# Claude Code project instructions (.claude/CLAUDE.md + .claude/docs/) are
# deliberately COMMITTED — they document architecture, process and constraints,
# contain no client data, and should be versioned alongside the code they
# describe. Machine-local agent settings (.claude/settings.local.json) are
# ignored via the global gitignore, not here.
#
# Client-specific data must never be committed — see the entries above
# (doc-gen.config.yml, output/, unpacked/, dev.log, the caches).
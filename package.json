{
  "name": "powerautodocs",
  "version": "1.8.0",
  "description": "Automated as-built documentation generator for Power Platform solutions",
  "type": "module",
  "bin": {
    "powerautodocs": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lewginn/PowerAutoDocs.git"
  },
  "keywords": [
    "power-platform",
    "dataverse",
    "dynamics-365",
    "documentation",
    "azure-devops",
    "wiki"
  ],
  "author": "Lewis Ginn",
  "license": "MIT",
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.3.3",
    "@types/pdfmake": "^0.2.13",
    "adm-zip": "^0.5.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.102.0",
    "@mermaid-js/mermaid-cli": "^11.16.0",
    "docx": "^9.6.1",
    "fast-xml-parser": "^5.4.2",
    "js-yaml": "^4.1.1",
    "openai": "^6.42.0",
    "pdfmake": "^0.2.23",
    "puppeteer": "^25.3.0"
  },
  "scripts": {
    "dev": "tsx src/index.ts > dev.log 2>&1",
    "dev:word": "tsx src/index.ts --word > dev.log 2>&1",
    "dev:wiki": "tsx src/index.ts --wiki > dev.log 2>&1",
    "dev:both": "tsx src/index.ts --word --wiki > dev.log 2>&1",
    "build": "tsc",
    "postbuild": "node scripts/addShebang.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "docs": "cd docs-viewer && npm run build && npx serve dist"
  },
  "engines": {
    "node": ">=22"
  }
}
